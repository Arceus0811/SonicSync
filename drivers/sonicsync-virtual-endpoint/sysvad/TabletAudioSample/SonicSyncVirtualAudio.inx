[Version]
Signature="$Windows NT$"
Class=MEDIA
Provider=%ProviderName%
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer=10/21/2026,1.0.0.0
CatalogFile=SonicSyncVirtualAudio.cat
PnpLockDown=1

[SourceDisksNames]
222="SonicSync Virtual Audio Driver Disk","",222
[SourceDisksFiles]
SonicSyncVirtualAudio.sys=222
[SignatureAttributes]
SonicSyncVirtualAudio.sys=SignatureAttributes.DRM
[SignatureAttributes.DRM]
DRMLevel=1300

[Manufacturer]
%MfgName%=SonicSync,NT$ARCH$.10.0...22621
[SonicSync.NT$ARCH$.10.0...22621]
%DeviceDesc%=SonicSync_Install,Root\SonicSyncVirtualAudio

[DestinationDirs]
SonicSync.CopyFiles=13
[SonicSync.CopyFiles]
SonicSyncVirtualAudio.sys
[SonicSync.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,SonicSyncVirtualAudio.sys
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%MidiDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[SonicSync.I.WaveRender]
AddReg=SonicSync.I.WaveRender.AddReg
[SonicSync.I.WaveRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveRenderName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
[SonicSync.I.TopologyRender]
AddReg=SonicSync.I.TopologyRender.AddReg
[SonicSync.I.TopologyRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyRenderName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[SonicSync_Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration,MsApoFxProxy.Registration
CopyFiles=SonicSync.CopyFiles
AddReg=SonicSync.AddReg
[SonicSync_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveRender%,SonicSync.I.WaveRender
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveRender%,SonicSync.I.WaveRender
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveRender%,SonicSync.I.WaveRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyRender%,SonicSync.I.TopologyRender
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyRender%,SonicSync.I.TopologyRender
[SonicSync_Install.NT.Services]
AddService=SonicSyncVirtualAudio,0x00000002,SonicSync.Service
[SonicSync.Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SonicSyncVirtualAudio.sys
[SonicSync_Install.NT.HW]
AddReg=SonicSync.Hardware
[SonicSync.Hardware]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[SonicSync_Install.NT.Wdf]
KmdfService=SonicSyncVirtualAudio,SonicSync_Wdf
[SonicSync_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
