#include "resource.h"
#include <windows.h>

IDI_SONICSYNC ICON "@SONICSYNC_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SonicSync Audio\0"
      VALUE "FileDescription", "SonicSync Personal Audio\0"
      VALUE "FileVersion", "1.0.2.0\0"
      VALUE "InternalName", "SonicSync\0"
      VALUE "OriginalFilename", "sonicsync_gui.exe\0"
      VALUE "ProductName", "SonicSync\0"
      VALUE "ProductVersion", "1.0.2.0\0"
      VALUE "LegalCopyright", "Copyright (c) SonicSync\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
