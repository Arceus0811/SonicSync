set(catalog "${CMAKE_CURRENT_LIST_DIR}/presets.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
file(READ "${catalog}" data)
function(eq_array out)
  set(values "")
  foreach(i RANGE 0 9)
    string(JSON value GET "${data}" ${ARGN} ${i})
    list(APPEND values "${value}")
  endforeach()
  list(JOIN values ", " values)
  set(${out} "{${values}}" PARENT_SCOPE)
endfunction()
eq_array(hz frequencies)
set(header "inline constexpr std::array<double,10> centers${hz};\ninline constexpr CatalogEntry catalog[]{\n")
string(JSON count LENGTH "${data}" presets)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
  string(JSON id GET "${data}" presets ${i} id)
  string(JSON name GET "${data}" presets ${i} name)
  eq_array(gains presets ${i} gains)
  eq_array(response presets ${i} responseDb)
  string(APPEND header "{\"${id}\",\"${name}\",${gains},${response}},\n")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/eq_catalog.inc" "${header}};\n")
